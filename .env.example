# Скопируйте в .env и заполните. Файл .env в git не попадает.

# OpenAlex: почта для "polite pool" (выше лимиты), ключ не обязателен
OPENALEX_MAILTO=
OPENALEX_API_KEY=

# GitHub: токен повышает лимит поиска с 10 до 30 запросов в минуту (права не нужны)
GITHUB_TOKEN=

# Хранилище: в docker compose задаётся автоматически; без переменной используется SQLite в data/wsignals.db
DATABASE_URL=

# Языковая модель (необязательно): только из разрешённого ТЗ списка. Без неё резюме собирается по шаблону из данных,
# а запрос разбирается детерминированным словарём направлений. Запрос из-за недоступности модели не падает никогда.
# LLM_PROVIDER=yandexgpt | gigachat | openai
LLM_PROVIDER=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5-lite
# Модель для разбора запроса и канонизации кандидатов. Выбор только явный, автоподбора нет.
# Допустимо ровно одно значение: yandexgpt-5-lite (проверено живым вызовом REST). Суффикс версии не указывается.
YANDEX_QUERY_MODEL=yandexgpt-5-lite
GIGACHAT_TOKEN=
GIGACHAT_MODEL=GigaChat-2-Pro
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# Патентный слой Google Patents через BigQuery (исследовательский модуль src/)
GCP_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
BQ_MAX_BYTES_BILLED=50000000000

# Бюджет интерактивного запроса: цель и жёсткий предел в секундах (PHASE 6).
WSIGNALS_QUERY_TARGET=60
WSIGNALS_QUERY_BUDGET=90
# Профиль повторов живого пути. Офлайн-сбор датасета эти переменные не трогают.
WSIGNALS_LIVE_RETRIES=2
WSIGNALS_LIVE_TIMEOUT=8
# Таймаут вызова языковой модели
WSIGNALS_LLM_TIMEOUT=20
# Реестр прогнозов: вынесите на том, иначе живой запрос дописывает файл в дереве репозитория
WSIGNALS_FORECAST_REGISTRY=
